<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Appointments.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="dbup-sqlserver" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL migrations ship inside the assembly and are applied by DbUp at startup. -->
    <EmbeddedResource Include="Data\Scripts\*.sql" />
    <EmbeddedResource Include="Data\Demo\*.sql" />
  </ItemGroup>

</Project>
